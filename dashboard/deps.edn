{:paths ["../src/main/resources" ; dashboard/*.cljc sources live in the main jar's resources
        "../target/classes"]     ; compiled Java classes (repl.agent.NreplAgent etc.) — run `mvn compile` in the project root first

 :deps {com.hyperfiddle/electric {:mvn/version "v3-alpha-ca05cbc93"} ; keep in sync with ../pom.xml
        org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/clojurescript {:mvn/version "1.11.121"}
        ring/ring {:mvn/version "1.15.3"}}

 :aliases {:build ; clj -X:build build-client — NOT -T: Electric compilation needs the app classpath
           {:extra-paths ["src-build"]
            :ns-default build
            :extra-deps {thheller/shadow-cljs {:mvn/version "2.26.2"}
                         io.github.clojure/tools.build {:mvn/version "0.10.8"}
                         ;; fixes NoClassDefFoundError com/google/common/collect/Streams in shadow
                         com.google.guava/guava {:mvn/version "31.1-jre"}}}}

 :mvn/repos {"clojars" {:url "https://repo.clojars.org/"}}}
